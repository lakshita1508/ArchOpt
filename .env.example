# Copy to .env (repo root). All values optional.
# Path to a custom engine binary (default: engine/build/archopt_engine[.exe])
# ARCHOPT_ENGINE=
# Secret used to sign login tokens (set a random string for anything beyond a local demo)
# ARCHOPT_SECRET=change-me
# Optional AI brief assistant. Leave empty: the app works without it (manual form only).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
